# Solo para el script local admin:user. Nunca uses el prefijo NUXT_PUBLIC_ para esta clave.
# Clave secret (sb_secret_...) o service_role del mismo proyecto que la URL de .env.
SUPABASE_SECRET_KEY=""

# Authentication → Users → usuario → UID. La cuenta debe existir.
MIRUTA_ADMIN_USER_ID=""

# Opcional: correo actual esperado para comprobar que has elegido la cuenta correcta.
MIRUTA_ADMIN_EXPECTED_EMAIL=""

# Rellena uno o ambos. Vacío significa que ese campo no se modifica.
# Usa comillas para conservar espacios y caracteres como # en la contraseña.
MIRUTA_ADMIN_NEW_EMAIL=""
MIRUTA_ADMIN_NEW_PASSWORD=""

# true marca el nuevo correo como confirmado sin enviar un enlace de verificación.
MIRUTA_ADMIN_CONFIRM_EMAIL=true
